// The backend's publishable key. It is public by design: it ships inside every app build,
// and row-level security protects the data. Never put a secret or service_role key here.
// To use another backend, override it in Local.xcconfig, next to this file, which git ignores:
//   WINGSPOT_PUBLISHABLE_KEY = <key>
WINGSPOT_PUBLISHABLE_KEY = sb_publishable_lWulnPUXjeRfnM8VNu50lw_A0vESCcF
#include? "Local.xcconfig"
