{
  "sourceLanguage": "en",
  "strings": {
    "NSCameraUsageDescription": {
      "comment": "Camera permission prompt for scanning boarding passes",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wingspotted scannt deine Bordkarte, um einen Flug auszufüllen. Dein Name und dein Buchungscode werden nie gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wingspotted scans your boarding pass to fill in a flight. Your name and booking code are never saved."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "comment": "Location permission prompt",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wingspotted schlägt dir beim Check-in den Flughafen vor, an dem du gerade bist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wingspotted suggests the airport you're at when you check in."
          }
        }
      }
    },
    "Spotted": {
