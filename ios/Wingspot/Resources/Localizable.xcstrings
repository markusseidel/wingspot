{
  "sourceLanguage": "en",
  "strings": {
    "%@, registered in %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, registriert in %2$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, registered in %2$@"
          }
        }
      }
    },
    "A flight you were on": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Flug, auf dem du warst"
          }
        }
      }
    },
    "A388, Boeing 737, CRJ900": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "A388, Boeing 737, CRJ900"
          }
        }
      }
    },
    "Aircraft and airport search needs one download while online. You can still check in by registration.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Suche nach Flugzeugen und Flughäfen braucht einmalig einen Download mit Internetverbindung. Du kannst trotzdem per Registrierung einchecken."
          }
        }
      }
    },
    "Aircraft type": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Flugzeugtyp"
          }
        }
      }
    },
