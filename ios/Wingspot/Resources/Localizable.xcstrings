    "The file is too large" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datei ist zu groß"
          }
        }
      }
    },
    "The flown route (%lld positions) is saved on this iPhone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die geflogene Strecke (%lld Positionen) ist auf diesem iPhone gespeichert."
          }
        }
      }
    },
    "The friends you choose will see this check-in. Up to %lld." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die gewählten Freunde sehen diesen Check-in. Bis zu %lld."
          }
        }
      }
    },
    "The map needs the airport data. Open the app once while online." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Karte braucht die Flughafendaten. Öffne die App einmal mit Internet."
          }
        }
      }
    },
    "The name needs 3 to 80 characters." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Name braucht 3 bis 80 Zeichen."
          }
        }
      }
    },
    "The old link and code stop working." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der alte Link und Code funktionieren dann nicht mehr."
          }
        }
      }
    },
    "The route has a gap of %@. The flown distance is an estimate, a little too short." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Strecke hat eine Lücke von %@. Die geflogene Strecke ist eine Schätzung und etwas zu kurz."
          }
        }
      }
    },
    "There is no airport within 150 km of this position." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Umkreis von 150 km um diese Position gibt es keinen Flughafen."
          }
        }
      }
    },
    "There is no way to get your account back." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Konto kann nicht wiederhergestellt werden."
          }
        }
      }
    },
    "These friends added this to their own check-ins." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Freunde haben das zu ihren eigenen Check-ins hinzugefügt."
          }
        }
      }
    },
    "They invited you to Wingspot. You can unfollow any time." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Person hat dich zu Wingspot eingeladen. Du kannst jederzeit entfolgen."
          }
        }
      }
    },
    "This backup was made by a newer version of Wingspot. Please update the app." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Backup wurde mit einer neueren Version von Wingspot erstellt. Bitte aktualisiere die App."
          }
        }
      }
    },
    "This comment isn't allowed. Please rephrase it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Kommentar ist nicht erlaubt. Bitte formuliere ihn um."
          }
        }
      }
    },
    "This doesn't contain a position. Open the place in the maps app and copy its full link, or the coordinates." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier steckt keine Position drin. Öffne den Ort in der Karten-App und kopiere den vollständigen Link oder die Koordinaten."
