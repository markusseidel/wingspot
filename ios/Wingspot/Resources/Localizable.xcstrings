      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Flughafen"
          }
        }
      }
    },
    "An aircraft you have seen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Flugzeug, das du gesehen hast"
          }
        }
      }
    },
