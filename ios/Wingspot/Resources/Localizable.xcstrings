      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Flughafen"
          }
        }
      }
    },
    "None": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keiner"
          }
        }
      }
    },
    "Not a valid registration yet": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine gültige Registrierung"
          }
        }
      }
    },
    "Not downloaded yet": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nicht geladen"
          }
        }
      }
    },
    "Not now": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Später"
          }
        }
      }
    },
    "OK": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        }
      }
    },
    "Optional": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional"
          }
        }
      }
    },
    "Optional. Shown on your profile.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. Wird in deinem Profil angezeigt."
          }
        }
      }
    },
    "Please enter a valid email address.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte gib eine gültige E-Mail-Adresse ein."
          }
        }
      }
    },
    "Please try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte versuche es noch einmal."
          }
        }
      }
    },
    "Profile": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil"
          }
        }
      }
    },
    "Registration, e.g. DAIMA": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrierung (DAIMA)"
          }
        }
      }
    },
    "Remove type": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Typ entfernen"
          }
        }
      }
    },
    "Save": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichern"
          }
        }
      }
    },
    "Search aircraft, airports and spotters.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Suche nach Flugzeugen, Flughäfen und Spottern."
          }
        }
      }
    },
    "Search works offline after one download while online.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Suche funktioniert offline, sobald die Daten einmal mit Internetverbindung geladen wurden."
          }
        }
      }
    },
    "Seen for the %@ time": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum %@ Mal gesehen"
          }
        }
      }
    },
    "Send link": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Link senden"
          }
        }
      }
    },
    "Set": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Festgelegt"
          }
        }
      }
    },
    "Sign in": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmelden"
          }
        }
      }
    },
    "Sign in to keep your check-ins safe and follow other spotters. Your check-ins stay on this iPhone until then.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich an, um deine Check-ins zu sichern und anderen Spottern zu folgen. Bis dahin bleiben deine Check-ins auf diesem iPhone."
          }
        }
      }
    },
    "Sign in with email": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit E-Mail anmelden"
          }
        }
      }
    },
    "Sign out": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abmelden"
          }
        }
      }
    },
    "Sign-in isn't available in this version of the app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung ist in dieser App-Version nicht verfügbar."
          }
        }
      }
    },
    "Something went wrong. Please try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwas ist schiefgelaufen. Bitte versuche es noch einmal."
          }
        }
      }
    },
    "Spot with friends": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotte mit Freunden"
          }
        }
      }
    },
    "Spotted": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespottet"
          }
        }
      }
    },
    "This sign-in link doesn't work anymore. Please request a new one on this device.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Anmeldelink funktioniert nicht mehr. Bitte fordere auf diesem Gerät einen neuen an."
          }
        }
      }
    },
    "This username is taken. Please try another one.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Benutzername ist vergeben. Bitte versuche einen anderen."
          }
        }
      }
    },
    "Too many attempts. Please wait a moment and try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viele Versuche. Bitte warte kurz und versuche es noch einmal."
          }
        }
      }
    },
    "Try again": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erneut versuchen"
          }
        }
      }
    },
    "Use 3 to 30 lowercase letters, numbers or underscores.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende 3 bis 30 Kleinbuchstaben, Zahlen oder Unterstriche."
          }
        }
      }
    },
    "Use a different email": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere E-Mail-Adresse verwenden"
          }
        }
      }
    },
    "Username": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benutzername"
          }
        }
      }
    },
    "We sent a link to %@. Open it on this iPhone to sign in.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir haben einen Link an %@ gesendet. Öffne ihn auf diesem iPhone, um dich anzumelden."
          }
        }
      }
    },
    "We'll email you a link to sign in. You don't need a password.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir senden dir per E-Mail einen Link zum Anmelden. Du brauchst kein Passwort."
          }
        }
      }
    },
    "You're offline. Please connect to the internet and try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist offline. Bitte verbinde dich mit dem Internet und versuche es noch einmal."
          }
        }
      }
    },
    "Your check-ins stay on this iPhone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Check-ins bleiben auf diesem iPhone."
          }
        }
      }
    },
    "Your profile": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Profil"
          }
        }
      }
    }
  },
  "version": "1.0"
}