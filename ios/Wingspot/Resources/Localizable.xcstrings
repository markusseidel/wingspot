{
  "sourceLanguage": "en",
  "strings": {
    "%@, registered in %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, registriert in %2$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, registered in %2$@"
          }
        }
      }
    },
    "3 to 30 lowercase letters, numbers or underscores.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "3 bis 30 Kleinbuchstaben, Zahlen oder Unterstriche."
          }
        }
      }
    },
    "A flight you were on": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Flug, auf dem du warst"
          }
        }
      }
    },
    "A388, Boeing 737, CRJ900": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "A388, Boeing 737, CRJ900"
          }
        }
      }
    },
    "Aircraft and airport search needs one download while online. You can still check in by registration.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Suche nach Flugzeugen und Flughäfen braucht einmalig einen Download mit Internetverbindung. Du kannst trotzdem per Registrierung einchecken."
          }
        }
      }
    },
    "Aircraft type": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Flugzeugtyp"
          }
        }
      }
    },
    "Airport": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Flughafen"
          }
        }
      }
    },
    "An aircraft you have seen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Flugzeug, das du gesehen hast"
          }
        }
      }
    },
    "An airport you are at": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Flughafen, an dem du gerade bist"
          }
        }
      }
    },
    "Badges": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Badges"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbrechen"
          }
        }
      }
    },
    "Check in": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Check-in"
          }
        }
      }
    },
    "Check in another": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weiterer Check-in"
          }
        }
      }
    },
    "Check your connection and try again. You can still check in.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe deine Verbindung und versuche es noch einmal. Einchecken kannst du trotzdem."
          }
        }
      }
    },
    "Check your email": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schau in dein E-Mail-Postfach"
          }
        }
      }
    },
    "Check-ins from people you follow will appear here.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier erscheinen Check-ins von Leuten, denen du folgst."
          }
        }
      }
    },
    "Collect aircraft types, airlines and airports as you go.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sammle nebenbei Flugzeugtypen, Airlines und Flughäfen."
          }
        }
      }
    },
    "Coming in a later app version.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kommt in einer späteren App-Version."
          }
        }
      }
    },
    "Couldn't load your profile": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil konnte nicht geladen werden"
          }
        }
      }
    },
    "Couldn't save this check-in": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Check-in konnte nicht gespeichert werden"
          }
        }
      }
    },
    "Couldn't sign in": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmeldung fehlgeschlagen"
          }
        }
      }
    },
    "Couldn't sign out": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abmeldung fehlgeschlagen"
          }
        }
      }
    },
    "Create your profile": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil erstellen"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fertig"
          }
        }
      }
    },
    "Downloading aircraft and airport data.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Flugzeug- und Flughafendaten werden geladen."
          }
        }
      }
    },
    "Earn badges": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sammle Badges"
          }
        }
      }
    },
    "Earn badges for the aircraft you spot and fly.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sammle Badges für die Flugzeuge, die du spottest und mit denen du fliegst."
          }
        }
      }
    },
    "Edit profile": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil bearbeiten"
          }
        }
      }
    },
    "Email address": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "E-Mail-Adresse"
          }
        }
      }
    },
    "Enter a registration and see if it's new to you. It works offline too.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib eine Registrierung ein und sieh, ob sie neu für dich ist. Das geht auch offline."
          }
        }
      }
    },
    "Enter a registration, or choose a type if you couldn't read it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib eine Registrierung ein oder wähle einen Typ, falls du sie nicht lesen konntest."
          }
        }
      }
    },
    "Explore": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entdecken"
          }
        }
      }
    },
    "FRA, Frankfurt, Vienna": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "FRA, Frankfurt, Wien"
          }
        }
      }
    },
    "Feed": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Feed"
          }
        }
      }
    },
    "First time seeing this one!": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum ersten Mal gesehen!"
          }
        }
      }
    },
    "Flown": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geflogen"
          }
        }
      }
    },
    "Follow other spotters and share what you've seen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Folge anderen Spottern und teile, was du gesehen hast."
          }
        }
      }
    },
    "Home airport": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heimatflughafen"
          }
        }
      }
    },
    "Last time at %@, %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuletzt in %1$@, %2$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last time at %1$@, %2$@"
          }
        }
      }
    },
    "Last time on %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuletzt am %@"
          }
        }
      }
    },
    "Log every aircraft": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte jedes Flugzeug fest"
          }
        }
      }
    },
    "Name": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Name"
          }
        }
      }
    },
