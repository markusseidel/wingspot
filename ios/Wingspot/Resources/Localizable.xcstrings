      }
    },
    "We'll email you a link to sign in. You don't need a password." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir senden dir per E-Mail einen Link zum Anmelden. Du brauchst kein Passwort."
          }
        }
      }
    },
    "What happened?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was ist passiert?"
          }
        }
      }
    },
    "Which flight?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welcher Flug?"
          }
        }
      }
    },
    "Why do you want to report %@?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warum möchtest du %@ melden?"
          }
        }
      }
    },
    "Wingspot is for people who love aircraft. To keep it friendly, please agree to these rules before you follow people, see the feed, or share your check-ins." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wingspot ist für Menschen, die Flugzeuge lieben. Damit es freundlich bleibt, stimme bitte diesen Regeln zu, bevor du Leuten folgst, den Feed siehst oder deine Check-ins teilst."
          }
        }
      }
    },
    "Working" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arbeit"
          }
        }
      }
    },
    "Write a comment…" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kommentar schreiben …"
          }
        }
      }
    },
    "You" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du"
          }
        }
      }
    },
    "You can also block someone on their profile, so you don't see them anymore." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst jemanden auch in seinem Profil blockieren, dann siehst du ihn nicht mehr."
          }
        }
      }
    },
    "You can report a person, check-in or comment, and block anyone. We review reports and may remove content or accounts that break these rules." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst Personen, Check-ins und Kommentare melden und jeden blockieren. Wir prüfen Meldungen und können Inhalte oder Konten entfernen, die gegen diese Regeln verstoßen."
          }
        }
      }
    },
    "You haven't checked in here yet." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast hier noch nicht eingecheckt."
          }
        }
      }
    },
    "You won't see each other's check-ins or comments anymore, and any follows between you end." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr seht keine Check-ins und Kommentare voneinander mehr, und bestehende Follows enden."
          }
        }
      }
    },
    "You're offline. Please connect to the internet and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist offline. Bitte verbinde dich mit dem Internet und versuche es noch einmal."
          }
        }
      }
    },
    "You're responsible for what you post. Comments with insults are refused automatically." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist für das verantwortlich, was du postest. Kommentare mit Beleidigungen werden automatisch abgelehnt."
          }
        }
      }
    },
    "Your check-ins" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Check-ins"
          }
        }
      }
    },
    "Your check-ins stay on this iPhone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
