            "value" : "Hochgeladen"
          }
        }
      }
    },
    "Use 3 to 30 lowercase letters, numbers or underscores." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende 3 bis 30 Kleinbuchstaben, Zahlen oder Unterstriche."
          }
        }
      }
    },
    "Use a different email" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andere E-Mail-Adresse verwenden"
          }
        }
      }
    },
    "Username" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benutzername"
          }
        }
      }
